{
    "format_version": "1.21.0",
    "minecraft:entity": {
        "description": {
            "identifier": "minecraft:player",
            "spawn_category": "creature",
            "is_spawnable": false,
            "is_summonable": false
        },

        "component_groups": {
			
			"minecraft:attack_level_1": {"minecraft:attack": {"damage": 1}},
			"minecraft:attack_level_2": {"minecraft:attack": {"damage": 2}},
			"minecraft:attack_level_3": {"minecraft:attack": {"damage": 3}},
			"minecraft:attack_level_4": {"minecraft:attack": {"damage": 4}},
			"minecraft:attack_level_5": {"minecraft:attack": {"damage": 5}},
			"minecraft:attack_level_6": {"minecraft:attack": {"damage": 6}},
			"minecraft:attack_level_7": {"minecraft:attack": {"damage": 7}},
			"minecraft:attack_level_8": {"minecraft:attack": {"damage": 8}},
			"minecraft:attack_level_9": {"minecraft:attack": {"damage": 9}},
			"minecraft:attack_level_10": {"minecraft:attack": {"damage": 10}},
			
            "minecraft:add_raid_omen": {
                "minecraft:spell_effects": {
                    "add_effects": [{
                            "effect": "raid_omen",
                            "duration": 30,
                            "display_on_screen_animation": true
                        }
                    ],
                    "remove_effects": "bad_omen"
                },
                "minecraft:timer": {
                    "time": [0.0, 0.0],
                    "looping": false,
                    "time_down_event": {
                        "event": "minecraft:clear_add_raid_omen",
                        "target": "self"
                    }
                }
            },
            "minecraft:clear_raid_omen_spell_effect": {
                "minecraft:spell_effects": {}
            },
            "minecraft:raid_trigger": {
                "minecraft:raid_trigger": {
                    "triggered_event": {
                        "event": "minecraft:remove_raid_trigger",
                        "target": "self"
                    }
                }
            }
        },

        "components": {
            "minecraft:experience_reward": {
                "on_death": "Math.Min(query.player_level * 7, 100)"
            },
            "minecraft:type_family": {
                "family": ["player"]
            },
            "minecraft:is_hidden_when_invisible": {},
            "minecraft:loot": {
                "table": "loot_tables/empty.json"
            },
            "minecraft:collision_box": {
                "width": 0.6,
                "height": 1.8
            },
            "minecraft:can_climb": {},
            "minecraft:movement": {
                "value": 0.1
            },
            "minecraft:hurt_on_condition": {
                "damage_conditions": [{
                        "filters": {
                            "test": "in_lava",
                            "subject": "self",
                            "operator": "==",
                            "value": true
                        },
                        "cause": "lava",
                        "damage_per_tick": 4
                    }
                ]
            },

            "minecraft:exhaustion_values": {
                "heal": 3,
                "jump": 0.05,
                "sprint_jump": 0.2,
                "mine": 0.005,
                "attack": 0.1,
                "damage": 0.1,
                "walk": 0.0,
                "sprint": 0.1,
                "swim": 0.01
            },
            "minecraft:player.saturation": {
                "value": 5,
                "max": 1000
            },
            "minecraft:player.exhaustion": {
                "value": 0,
                "max": 2000
            },
            "minecraft:player.level": {
                "value": 0,
                "max": 24791
            },
            "minecraft:player.experience": {
                "value": 0,
                "max": 1
            },
            "minecraft:breathable": {
                "total_supply": 15,
                "suffocate_time": -1,
                "inhale_time": 3.75,
                "generates_bubbles": false
            },
            "minecraft:nameable": {
                "always_show": true,
                "allow_name_tag_renaming": false
            },
            "minecraft:physics": {
                "push_towards_closest_space": true
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": true
            },
            "minecraft:insomnia": {
                "days_until_insomnia": 3
            },
            "minecraft:rideable": {
                "seat_count": 2,
                "family_types": [
                    "parrot_tame"
                ],
                "pull_in_entities": true,
                "seats": [{
                        "position": [0.4, -0.2, -0.1],
                        "min_rider_count": 0,
                        "max_rider_count": 0,
                        "lock_rider_rotation": 0
                    }, {
                        "position": [-0.4, -0.2, -0.1],
                        "min_rider_count": 1,
                        "max_rider_count": 2,
                        "lock_rider_rotation": 0
                    }
                ]
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:block_climber": {},
            "minecraft:environment_sensor": {
                "triggers": [{
                        "filters": {
                            "all_of": [{
                                    "test": "has_mob_effect",
                                    "subject": "self",
                                    "value": "bad_omen"
                                }, {
                                    "test": "is_in_village",
                                    "subject": "self",
                                    "value": true
                                }
                            ]
                        },
                        "event": "minecraft:gain_raid_omen"
                    },
					{
						"filters": {
                            "all_of": [{
                                    "test": "has_tag",
                                    "subject": "self",
                                    "value": "common"
                                }
                            ]
                        },
                        "event": "minecraft:common"
                    },
					{
                        "filters": {
                            "all_of": [{
                                    "test": "has_tag",
                                    "subject": "self",
                                    "value": "toriko"
                                }
                            ]
                        },
                        "event": "minecraft:toriko_level"
                    },
					{
                        "filters": {
                            "all_of": [{
                                    "test": "has_tag",
                                    "subject": "self",
                                    "value": "zebura"
                                }
                            ]
                        },
                        "event": "minecraft:zebura_level"
                    },
					{
                        "filters": {
                            "all_of": [{
                                    "test": "has_tag",
                                    "subject": "self",
                                    "value": "coco"
                                }
                            ]
                        },
                        "event": "minecraft:coco_level"
                    },
					{
                        "filters": {
                            "all_of": [{
                                    "test": "actor_health",
                                    "subject": "self",
                                    "operator": "<",
                                    "value": 6
                                }
                            ]
                        },
                        "event": "minecraft:auto_fazi"
                    },
					{
                        "filters": {
                            "all_of": [{
                                    "test": "actor_health",
                                    "subject": "self",
                                    "operator": ">",
                                    "value": 0
                                }
                            ]
                        },
                        "event": "minecraft:await_effect"
                    }
                ]
            },
            "minecraft:damage_sensor": {
                "triggers": [
					{
					  "cause": "entity_explosion",
					  "deals_damage": false,
					  "on_damage": {
						"filters": {
						  "test": "has_tag",
						  "value": "zebura"
						}
					  }
					},
					{
						"on_damage": {
							"filters": {
								"all_of": [
									{
										"test": "has_tag",
										"subject": "self",
										"value": "coco"
									}
								]
							},
							"event": "minecraft:poison_skin"
						}
					},
					{
						"on_damage": {
							"filters": {
								"all_of": [
									{
										"test": "has_tag",
										"subject": "self",
										"value": "zebura"
									},
									{
										"test": "has_damage",
										"subject": "self",
										"value": "magic"
									}
								  ]
							},
							"event": "minecraft:sound_armor"
						}
					},
					{
						"on_damage": {
							"filters": {
								"all_of": [
									{
										"test": "has_tag",
										"subject": "self",
										"value": "toriko"
									}
								]
							},
							"event": "minecraft:folk_armor"
						}
					}
				]
            }
        },

        "events": {
			
			"minecraft:await_effect": {
                "queue_command": {
                    "command": [
					
						"execute if score @s strength matches 0..1000 run event entity @a minecraft:add_component_attack_level_1",
						"execute if score @s strength matches 1001..2000 run event entity @a minecraft:add_component_attack_level_2",
						"execute if score @s strength matches 2001..3500 run event entity @a minecraft:add_component_attack_level_3",
						"execute if score @s strength matches 3501..5500 run event entity @a minecraft:add_component_attack_level_4",
						"execute if score @s strength matches 5501..8000 run event entity @a minecraft:add_component_attack_level_5",
						"execute if score @s strength matches 8001..11000 run event entity @a minecraft:add_component_attack_level_6",
